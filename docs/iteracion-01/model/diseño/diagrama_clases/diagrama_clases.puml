@startuml
title Diagrama de Clases - UnixDriver

skinparam classAttributeIconSize 0

'========================
' ROLES Y USUARIOS
'========================

class Rol {
    - idRol: int
    - nombre: String
    --
    + consultarPermisos(): void
}

abstract class Usuario {
    - idUsuario: int
    - nombre: String
    - correo: String
    - contrasena: String
    - telefono: String
    - fechaRegistro: DateTime
    - fechaNacimiento: Date
    - estado: String
    --
    + registrarse(): String
    + iniciarSesion(): boolean
    + cerrarSesion(): void
    + actualizarPerfil(): void
}

class Pasajero {
    --
    + realizarBusqueda(): Busqueda
    + seleccionarOferta(oferta: Oferta): Viaje
    + consultarViajes(): List<Viaje>
    + cancelarViaje(viaje: Viaje): void
}

class Administrador {
    --
    + gestionarUsuarios(): void
    + gestionarPlataformas(): void
    + crearConfiguracionComision(): void
    + modificarConfiguracionComision(): void
    + desactivarConfiguracionComision(): void
    + generarReportes(): void
}

Rol "1" -- "0..*" Usuario : asignado a >
Usuario <|-- Pasajero
Usuario <|-- Administrador

'========================
' BUSQUEDA Y OFERTAS
'========================

class Busqueda {
    - idBusqueda: int
    - origen: String
    - destino: String
    - fechaHora: DateTime
    - estado: EstadoBusqueda
    --
    + validarDatos(): boolean
    + consultarOfertas(): List<Oferta>
    + obtenerResultados(): List<Oferta>
}

class Oferta {
    - idOferta: int
    - precioEstimado: Decimal
    - tiempoEstimado: int
    - distancia: Decimal
    - fechaHoraRespuesta: DateTime
    - estado: EstadoOferta
    --
    + consultarDetalles(): void
    + seleccionar(): void
    + compararOferta(): Decimal
}

Pasajero "1" -- "0..*" Busqueda : realiza >
Busqueda "1" *-- "0..*" Oferta : genera >

'========================
' PLATAFORMAS EXTERNAS
'========================

class Plataforma {
    - idPlataforma: int
    - nombre: String
    - estado: EstadoPlataforma
    --
    + consultarServicio(): void
    + recibirSolicitud(): void
    + enviarRespuesta(): void
    + verificarDisponibilidad(): boolean
}

Plataforma "1" -- "0..*" Oferta : ofrece >

'========================
' CONDUCTOR Y VEHICULO
'========================

class Conductor {
    - idConductor: int
    - nombre: String
    - calificacion: Decimal
    - telefono: String
    --
    + consultarPerfil(): void
    + consultarCalificacion(): Decimal
}

class Vehiculo {
    - idVehiculo: int
    - placa: String
    - marca: String
    - modelo: String
    - tipo: String
    --
    + consultarDetalles(): void
}

Oferta "0..*" --> "1" Conductor : asigna >
Oferta "0..*" --> "1" Vehiculo : utiliza >

'========================
' VIAJE
'========================

class Viaje {
    - idViaje: int
    - fechaHoraInicio: DateTime
    - fechaHoraFin: DateTime
    - precioFinal: Decimal
    - estado: EstadoViaje
    --
    + iniciarViaje(): void
    + finalizarViaje(): void
    + cancelarViaje(): void
    + consultarEstado(): EstadoViaje
}

Oferta "1" --> "0..1" Viaje : seleccionada para >

'========================
' CONFIGURACION DE COMISION
'========================

class ConfiguracionComision {
    - idConfiguracion: int
    - porcentaje: Decimal
    - fechaInicio: DateTime
    - fechaFin: DateTime
    - estado: EstadoConfiguracion
    --
    + activar(): void
    + desactivar(): void
    + modificarPorcentaje(): void
}

Administrador "1" -- "0..*" ConfiguracionComision : administra >

'========================
' COMISION
'========================

class Comision {
    - idComision: int
    - porcentajeAplicado: Decimal
    - fechaGeneracion: DateTime
    - estado: EstadoComision
    --
    + calcularComision(precioFinal: Decimal): Decimal
    + registrarComision(): void
}

Viaje "1" -- "0..1" Comision : genera >
ConfiguracionComision "1" -- "0..*" Comision : se aplica en >

'========================
' ENUMERACIONES
'========================

enum EstadoBusqueda {
    PENDIENTE
    PROCESANDO
    COMPLETADA
    SIN_RESULTADOS
    ERROR
}

enum EstadoOferta {
    DISPONIBLE
    SELECCIONADA
    NO_DISPONIBLE
    EXPIRADA
}

enum EstadoPlataforma {
    ACTIVO
    INACTIVO
}

enum EstadoViaje {
    SOLICITADO
    ACEPTADO
    EN_CURSO
    COMPLETADO
    CANCELADO
}

enum EstadoComision {
    GENERADA
    PAGADA
    ANULADA
}

enum EstadoConfiguracion {
    ACTIVA
    INACTIVA
}

@enduml