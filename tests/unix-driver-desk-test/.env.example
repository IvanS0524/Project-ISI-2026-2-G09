# Puerto de la aplicacion. Abre en Chrome: http://localhost:3000
PORT=3000

# MySQL / MariaDB de XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unixdriver
