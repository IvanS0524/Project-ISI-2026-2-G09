# UniX Driver · Configuración de entorno para la App Móvil (Capacitor 7 + AWS)
# ---------------------------------------------------------------------------
# Copie este archivo como `.env` y defina la URL de su servidor backend.
# El script `tools/sync-env.js` lee `UNIX_API_BASE_URL` desde `.env` y genera
# automáticamente `www/config/api-env.js` (ignorado en Git).
# ---------------------------------------------------------------------------

# Endpoint único del Backend FastAPI
UNIX_API_BASE_URL=http://localhost:8000

# Variables informativas de región y recursos Cloud (Amazon S3)
AWS_REGION=us-east-2
S3_BUCKET_NAME=unixdriver-data-cartagenabarrios-2026
S3_BARRIOS_KEY=barrios_cartagena.json

# Opcionales (Proveedores externos)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
