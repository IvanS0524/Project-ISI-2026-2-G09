# Copia este archivo como android/keystore.properties y rellena TUS datos.
# Sin este archivo el proyecto compila igual: la release queda sin firmar y la
# debug usa la llave de depuración que Gradle genera sola.
#
# Para crear tu propia llave (una sola vez, guárdala y no la pierdas):
#   keytool -genkeypair -v -keystore android/unixdriver-release.keystore \
#     -alias unixdriver -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile es relativo a la carpeta android/
storeFile=unixdriver-release.keystore
storePassword=TU_CONTRASENA_DEL_ALMACEN
keyAlias=unixdriver
keyPassword=TU_CONTRASENA_DE_LA_LLAVE
