# Opción 1: Conexión tradicional con URL directa (Local)
DATABASE_URL=postgresql+psycopg://postgres:tu_password@localhost:5432/unixdriver

# Opción 2: Conexión a Amazon RDS PostgreSQL con Autenticación Token IAM
USE_RDS_IAM=false
RDS_HOST=tu_instancia.xxxx.us-east-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=postgres
RDS_USER=postgres

# Configuración de Amazon S3 (Catálogo de barrios de Cartagena)
AWS_ACCESS_KEY_ID=tu_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
AWS_REGION=us-east-2
S3_BUCKET_NAME=unixdriver-data-cartagenabarrios-2026
S3_BARRIOS_KEY=barrios_cartagena.json

# API de Gemini para resolución inteligente de lugares turísticos de Cartagena (opcional; usa Nominatim + S3 como fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest